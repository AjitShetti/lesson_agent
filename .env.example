# Copy this file to .env and fill in the two keys. Never commit .env.
# Put comments on their own line, like these. Leave a MODEL line empty to use the default.
# Writer and judge should come from DIFFERENT vendors (see DESIGN.md, decision D4).
# Providers: groq, gemini, openai.

# ---- Writer: Groq ----
WRITER_PROVIDER=groq
WRITER_MODEL=
GROQ_API_KEY=

# ---- Judge: Google Gemini (AI Studio) ----
# The free tier allows about 20 requests per day for EACH model name.
# One lesson attempt uses 2 judge calls, so a full run (3 attempts) uses up to 6.
# If you hit "Out of quota", set JUDGE_MODEL to another Gemini model: each model has its own daily limit.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=
GEMINI_API_KEY=

# Wait this many seconds between calls to one provider (free tiers also limit calls per minute).
CALL_INTERVAL_SECONDS=4

# Retries after the first try. 2 means at most 3 attempts. The brief allows 1-2 retries, so values above 2 are lowered to 2.
MAX_RETRIES=2

# Optional: use OpenAI for either role
# OPENAI_API_KEY=
