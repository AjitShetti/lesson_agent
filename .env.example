# Copy this file to .env and fill it in. Never commit .env.
# Writer and judge should come from DIFFERENT vendors (see DESIGN.md, section 4).
# Providers: groq, gemini, xai, openai, anthropic.

# ---- Writer: Groq. The model defaults to qwen/qwen3.8-27b. ----
WRITER_PROVIDER=groq
WRITER_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Judge: Gemini. The model defaults to gemini-2.5-flash. ----
JUDGE_PROVIDER=gemini
JUDGE_MODEL=
GEMINI_API_KEY=

# Free tiers limit calls per minute. Wait this many seconds between calls to one provider.
# Increase this for strict provider tokens-per-minute limits.
CALL_INTERVAL_SECONDS=4

MAX_RETRIES=2

# Optional: other keys, or custom endpoints
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=  # supported for xAI; also accepted as a legacy Groq-key variable
# XAI_BASE_URL=https://api.x.ai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
